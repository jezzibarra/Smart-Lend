# ============================================================
# SLAP Smart Lending Application - Environment Configuration
# Copy this file to ".env" and fill in REAL values.
# NEVER commit ".env" or any file containing real secrets to Git.
# ============================================================

# Server port
PORT=5000

# Environment: development | production
NODE_ENV=development

# MongoDB connection string.
# Local:    mongodb://127.0.0.1:27017/smart_lend_db
# Atlas:    mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/smart_lend_db?retryWrites=true&w=majority
# Keep credentials ONLY here (server-side). Never place this string in frontend code.
MONGODB_URI=mongodb://127.0.0.1:27017/smart_lend_db

# JWT signing secret. Use a long random string (e.g. openssl rand -base64 48).
# Required in production. If omitted in development, a random per-boot secret is generated.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of frontend origins allowed for CORS.
# The frontend is normally served by this same server (same-origin), so this can stay empty.
# Example: ALLOWED_ORIGINS=http://localhost:5000,https://yourdomain.com
ALLOWED_ORIGINS=

# Google Identity Services OAuth client ID (used to verify Google sign-in tokens)
GOOGLE_CLIENT_ID=

# Comma-separated list of Google account emails allowed to sign in as admins.
AUTHORIZED_ADMIN_EMAILS=

# Initial admin bootstrap (used ONLY when no admin account exists yet).
# Leave empty to require scripts/setup-admin.js instead.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Email (SMTP) for OTP delivery. Leave empty to disable real email (dev mode logs OTP to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SLAP <no-reply@example.com>"

# Redis connection (distributed rate limiting + caching). Leave empty to use in-memory fallback.
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated list of trusted proxy IPs allowed to set X-Forwarded-For.
# Leave empty to ignore forwarded headers (recommended unless behind a proxy).
TRUSTED_PROXIES=

# ----------------------------------------------------
# Lending business rates (used by the Borrower Evaluation)
# ----------------------------------------------------
# Monthly interest rate as a decimal (0.05 = 5% per month)
LENDING_MONTHLY_RATE=0.05
# One-time processing fee as a decimal (0.02 = 2% of approved amount)
LENDING_PROCESSING_FEE_RATE=0.02
# Loan amount limits (PHP)
LENDING_MIN_AMOUNT=500
LENDING_MAX_AMOUNT=100000
